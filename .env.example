# ===== Mobile Backend — telemetry stack =====
# Copy: cp .env.example .env rồi điền giá trị thật. KHÔNG commit .env.

# --- MQTT (Mosquitto) ---
# User/pass dùng chung cho ESP32 và backend; script setup sinh passwd file lúc start.
MQTT_USER=esp32
MQTT_PASSWORD=change-me-strong-password

# MQTT user riêng cho app mobile (listener WebSocket 9001). Để trống thì
# scripts/mosquitto-setup.sh tự sinh random lúc container start và in ra
# `docker compose logs mosquitto` — nên lưu lại giá trị đó vào đây cho ổn định.
MQTT_APP_PASSWORD=

# Backend nối broker. Giữ giá trị service name khi chạy `docker compose up`;
# khi chạy backend trực tiếp trên host (tsx): mqtt://localhost:1883
MQTT_URL=mqtt://mosquitto:1883

# Prefix topic contract frontend (`<prefix>/room/{roomId}/...`) cho app mobile.
# Bridge dịch từ contract firmware `smarthome/...` sang prefix này; default smarthome.
TOPIC_PREFIX=smarthome

# --- InfluxDB 2.7 local (service `influxdb` trong compose) ---
# Image influxdb bắt buộc prefix INFLUXDB_INIT_* cho lần setup đầu; mode setup
# đọc các biến này để tạo org/bucket/admin token trong volume `influxdb-data`.
# (Tên biến phải giữ đúng — image tự đọc từ environment, không đổi được.)
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=change-me-admin-password
INFLUXDB_INIT_ORG=smarthome
INFLUXDB_INIT_BUCKET=telemetry
# Token admin: đặt chuỗi hex/random dài (vd `openssl rand -hex 32`).
INFLUXDB_INIT_ADMIN_TOKEN=change-me-openssl-rand-hex-32

# --- Backend đọc InfluxDB (src/env.ts) ---
# Phải trỏ CÙNG org/bucket/token với bộ INFLUXDB_INIT_* ở trên (image setup tạo
# org/bucket/token rồi backend dùng lại). Hai bộ tên khác nhau vì image influxdb
# cố định prefix INFLUXDB_INIT_*, còn backend đọc INFLUX_*.
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change-me-openssl-rand-hex-32
INFLUX_ORG=smarthome
INFLUX_BUCKET=telemetry

# Khi chạy backend/query CLI trực tiếp trên host (tsx), `influxdb` không resolve
# được từ ngoài mạng compose — đổi URL thành: http://localhost:8086
